# 상태 서명 키(임의의 긴 문자열). 미설정 시 서버 시작 때마다 임의 생성되어 재시작하면 진행 중인 단계 토큰이 무효가 됩니다.
SIGNING_KEY=change-me

# GitHub Copilot SDK 인증 토큰(Copilot 사용 권한이 있는 토큰). 미설정이면 AI 대신 규칙 기반 대체 결과가 표시됩니다.
COPILOT_GITHUB_TOKEN=

# 선택: 사용할 Copilot 모델 이름
COPILOT_MODEL=

# 선택(BYOK): Azure OpenAI 키를 Copilot SDK의 모델 공급자로 사용
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21
